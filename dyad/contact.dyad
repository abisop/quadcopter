"""
Compliant contact between one landing-gear foot and flat ground (NED z = z_ground).

Normal force (Hunt-Crossley form): F_n = delta+ * max(k + c * d(delta)/dt, 0),
where delta+ is a smooth positive part of the penetration. The force is zero
out of contact, continuous at touchdown, and never pulls the foot down.
Friction is regularized Coulomb: F_t = -mu * F_n * v_t / sqrt(|v_t|^2 + v_slip^2).
"""
component FootContact
  port = BodyPort()
  "Foot position relative to the centre of mass, body frame (FRD)"
  parameter r_foot::Position[3] = [0.12, 0.12, 0.1]
  "Ground height in NED (down positive)"
  parameter z_ground::Position = 0.0
  "Contact stiffness"
  parameter k::TranslationalSpringConstant = 600.0
  "Contact damping per unit penetration (Hunt-Crossley)"
  parameter c::Real(units = "N.s/m2") = 4000.0
  "Coulomb friction coefficient"
  parameter mu::Real = 0.6
  "Slip velocity at which friction reaches about 70% of mu * F_n"
  parameter v_slip::Velocity = 0.01
  "Smoothing length of the penetration positive part"
  parameter delta_s::Length = 1e-4
  "Smoothing of the max(., 0) on the normal stiffness term"
  parameter s_eps::TranslationalSpringConstant = 1.0
  "Foot position, NED"
  variable p_ned::Position[3]
  "Foot velocity, body frame"
  variable v_foot_b::Velocity[3]
  "Foot velocity, NED"
  variable v_foot_ned::Velocity[3]
  "Penetration depth (positive into the ground)"
  variable delta::Length
  "Smooth positive part of the penetration"
  variable delta_p::Length
  "Effective normal stiffness including damping, clipped at zero"
  variable s_n::TranslationalSpringConstant
  "Normal force on the foot, upward positive"
  variable F_n::Force
  "Tangential slip speed"
  variable v_t::Velocity
  "Contact force on the airframe, NED"
  variable F_ned::Force[3]
  "Contact force on the airframe, body frame"
  variable F_b::Force[3]
relations
  # Foot kinematics
  v_foot_b[1] = port.v[1] + port.w[2] * r_foot[3] - port.w[3] * r_foot[2]
  v_foot_b[2] = port.v[2] + port.w[3] * r_foot[1] - port.w[1] * r_foot[3]
  v_foot_b[3] = port.v[3] + port.w[1] * r_foot[2] - port.w[2] * r_foot[1]
  for i in 1:3
    p_ned[i] = port.r[i] + port.R[i, 1] * r_foot[1] + port.R[i, 2] * r_foot[2] + port.R[i, 3] * r_foot[3]
    v_foot_ned[i] = port.R[i, 1] * v_foot_b[1] + port.R[i, 2] * v_foot_b[2] + port.R[i, 3] * v_foot_b[3]
  end
  # Normal force
  delta = p_ned[3] - z_ground
  delta_p = max(delta, 0.0) + delta_s * log1p(exp(-abs(delta) / delta_s))
  s_n = 0.5 * (k + c * v_foot_ned[3] + sqrt((k + c * v_foot_ned[3]) ^ 2 + s_eps ^ 2))
  F_n = delta_p * s_n
  # Regularized Coulomb friction in the ground plane
  v_t = sqrt(v_foot_ned[1] ^ 2 + v_foot_ned[2] ^ 2 + v_slip ^ 2)
  F_ned[1] = -mu * F_n * v_foot_ned[1] / v_t
  F_ned[2] = -mu * F_n * v_foot_ned[2] / v_t
  F_ned[3] = -F_n
  # Resolve in body frame: F_b = R' * F_ned
  for i in 1:3
    F_b[i] = port.R[1, i] * F_ned[1] + port.R[2, i] * F_ned[2] + port.R[3, i] * F_ned[3]
  end
  # Load returned through the port (massless element)
  port.f = -F_b
  port.tau[1] = -(r_foot[2] * F_b[3] - r_foot[3] * F_b[2])
  port.tau[2] = -(r_foot[3] * F_b[1] - r_foot[1] * F_b[3])
  port.tau[3] = -(r_foot[1] * F_b[2] - r_foot[2] * F_b[1])
end

"""
Four-foot landing gear: one FootContact per corner, symmetric about the
centre of mass at (+-x_foot, +-y_foot, z_foot) in the body frame.
"""
component LandingGear
  port = BodyPort()
  "Longitudinal foot offset from the centre of mass"
  parameter x_foot::Length = 0.12
  "Lateral foot offset from the centre of mass"
  parameter y_foot::Length = 0.12
  "Foot height below the centre of mass (body z, down positive)"
  parameter z_foot::Length = 0.1
  "Contact stiffness per foot"
  parameter k::TranslationalSpringConstant = 600.0
  "Contact damping per unit penetration, per foot"
  parameter c::Real(units = "N.s/m2") = 4000.0
  "Coulomb friction coefficient"
  parameter mu::Real = 0.6
  "Ground height in NED"
  parameter z_ground::Position = 0.0
  foot_fr = FootContact(r_foot = [x_foot, y_foot, z_foot], k = k, c = c, mu = mu, z_ground = z_ground)
  foot_fl = FootContact(r_foot = [x_foot, -y_foot, z_foot], k = k, c = c, mu = mu, z_ground = z_ground)
  foot_rr = FootContact(r_foot = [-x_foot, y_foot, z_foot], k = k, c = c, mu = mu, z_ground = z_ground)
  foot_rl = FootContact(r_foot = [-x_foot, -y_foot, z_foot], k = k, c = c, mu = mu, z_ground = z_ground)
relations
  connect(port, foot_fr.port, foot_fl.port, foot_rr.port, foot_rl.port)
end
